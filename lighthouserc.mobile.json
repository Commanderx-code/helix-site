{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/",
        "/tools/toolbox/",
        "/tools/boot/",
        "/tools/touchdown/",
        "/tools/webos-launcher/",
        "/tools/config-bible/",
        "/contact/",
        "/news/",
        "/privacy/",
        "/404.html",
        "/coming-soon/",
        "/maintenance/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse/mobile"
    }
  }
}
