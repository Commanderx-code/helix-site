---
// The double helix in its orbit, as on the Helix Toolbox dashboard: the
// outer ring turns one way, the middle ring the other, each carrying a
// glowing moon, while the helix holds still. One full turn of the helix:
// the strands cross at the top, middle and bottom.
const amp = 38;
const steps = 40;
const strand = (phase: number) =>
  Array.from({ length: steps + 1 }, (_, i) => {
    const t = i / steps;
    const y = 14 + t * 172;
    const x = 60 + amp * Math.sin(t * 2 * Math.PI + phase);
    return `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }).join(' ');

const rungs = [0.1, 0.18, 0.32, 0.4, 0.6, 0.68, 0.82, 0.9].map((t) => {
  const dx = Math.abs(amp * Math.sin(t * 2 * Math.PI));
  return { y: (14 + t * 172).toFixed(1), x1: (60 - dx).toFixed(1), x2: (60 + dx).toFixed(1) };
});
---
<div class="orbit" aria-hidden="true">
  <span class="ring outer"><span class="moon mint"></span></span>
  <span class="ring middle"><span class="moon violet"></span></span>
  <span class="ring inner"></span>
  <svg class="strands" viewBox="0 0 120 200">
    <defs>
      <linearGradient id="helix-a" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="stop-a" />
        <stop offset="1" class="stop-b" />
      </linearGradient>
      <linearGradient id="helix-b" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="stop-b" />
        <stop offset="1" class="stop-a" />
      </linearGradient>
    </defs>
    <g class="rungs">
      {rungs.map((r) => <line x1={r.x1} x2={r.x2} y1={r.y} y2={r.y} />)}
    </g>
    <path d={strand(0)} stroke="url(#helix-a)" />
    <path d={strand(Math.PI)} stroke="url(#helix-b)" />
  </svg>
</div>

<style>
  .orbit {
    position: relative;
    width: 100%;
    max-width: 26rem;
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--mint) 28%, transparent);
  }
  .outer {
    inset: 0;
    animation: spin 26s linear infinite;
  }
  .middle {
    inset: 11.5%;
    border-color: color-mix(in srgb, var(--violet) 30%, transparent);
    animation: spin 18s linear infinite reverse;
  }
  .inner {
    inset: 24%;
    background: var(--deep);
    box-shadow: 0 0 30px color-mix(in srgb, var(--mint) 22%, transparent);
  }
  .moon {
    position: absolute;
    top: -4px;
    left: calc(50% - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .moon.mint {
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }
  .moon.violet {
    background: var(--violet);
    box-shadow: 0 0 10px var(--violet);
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .strands {
    position: relative;
    width: 36%;
    height: 60%;
    overflow: visible;
  }
  .stop-a { stop-color: var(--mint); }
  .stop-b { stop-color: var(--violet); }
  .rungs line {
    stroke: var(--line-strong);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  path {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
