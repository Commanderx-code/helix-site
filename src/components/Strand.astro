---
// One turn of the double helix. Rows stack these so the strands run
// unbroken down the tool list; the strands cross at the top, middle and
// bottom of each turn, and the tool sits level with the middle crossing.
interface Props {
  index: number;
}
const { index } = Astro.props;

const amp = 38;
const steps = 48;
const strand = (phase: number) =>
  Array.from({ length: steps + 1 }, (_, i) => {
    const y = (i / steps) * 100;
    const x = 50 + amp * Math.sin((y / 100) * 2 * Math.PI + phase);
    return `${i ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`;
  }).join(' ');

const rungs = [8, 16, 24, 32, 40, 60, 68, 76, 84, 92].map((y) => {
  const dx = amp * Math.sin((y / 100) * 2 * Math.PI);
  return { y, x1: 50 - dx, x2: 50 + dx };
});
---
<svg class="strand" data-turn={index} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
  <g class="rungs">
    {rungs.map((r) => <line x1={r.x1} x2={r.x2} y1={r.y} y2={r.y} vector-effect="non-scaling-stroke" />)}
  </g>
  <path class="a" d={strand(0)} vector-effect="non-scaling-stroke" />
  <path class="b" d={strand(Math.PI)} vector-effect="non-scaling-stroke" />
</svg>

<style>
  .strand {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: reveal 1s cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  path {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .a { stroke: var(--cyan); }
  .b { stroke: var(--violet); }
  .rungs line {
    stroke: var(--line);
    stroke-width: 3;
    stroke-linecap: round;
  }
  /* The strand grows down the page once, on load */
  [data-turn='1'] { animation-delay: 0.2s; }
  [data-turn='2'] { animation-delay: 0.4s; }
  [data-turn='3'] { animation-delay: 0.6s; }
  [data-turn='4'] { animation-delay: 0.8s; }
  @keyframes reveal {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
