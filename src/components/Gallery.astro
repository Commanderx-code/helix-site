---
// A tool's screenshots as a carousel: one large slide each, with its
// caption, opening in a viewer over the page. Without JavaScript it is a row
// you swipe or scroll, and a slide links to the full-size file;
// scripts/showcase.ts adds the buttons, the dots and the timed advance, as
// it does for the slider on the home page, and scripts/lightbox.ts the viewer.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Shot } from '../data/tools';

interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;

// Every slide is the same box, sized to the widest shot, so a taller shot
// among them, like a portrait window, sits letterboxed in it instead of
// stretching the row to its height
const widest = Math.max(...shots.map((shot) => shot.src.width / shot.src.height));
const boxes: [string, number][] = [
  ['wide', 16 / 9],
  ['laptop', 16 / 10],
  ['photo', 3 / 2],
  ['tablet', 7 / 5],
  ['classic', 4 / 3],
];
const [box] = boxes.reduce((best, next) => (Math.abs(next[1] - widest) < Math.abs(best[1] - widest) ? next : best));
---
<section class:list={['gallery', box]} aria-roledescription="carousel" aria-label="Screenshots" data-showcase>
  <div class="track" data-track>
    {
      shots.map((shot, i) => (
        <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${shots.length}`}>
          <a href={shot.src.src}>
            <span class="over" aria-hidden="true">
              <span class="over-text">{shot.alt}</span>
              <span class="over-hint">Open full size <Icon name="arrow-right" size={14} /></span>
            </span>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[640, 1100, 1600]}
              sizes="(max-width: 75rem) 100vw, 75rem"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </a>
          <figcaption>{shot.alt}</figcaption>
        </figure>
      ))
    }
  </div>
  <div class="controls" data-controls hidden>
    <button type="button" class="round" data-prev aria-label="Previous screenshot">
      <Icon name="arrow-left" size={18} />
    </button>
    <div class="dots">
      {
        shots.map((shot, i) => (
          <button type="button" class="dot" data-dot={i} aria-label={`Show: ${shot.alt}`}>
            <span />
          </button>
        ))
      }
    </div>
    <button type="button" class="round" data-next aria-label="Next screenshot">
      <Icon name="arrow-right" size={18} />
    </button>
    <button type="button" class="pause" data-pause>Pause</button>
  </div>
  <dialog class="viewer" data-lightbox data-dark aria-label="Screenshot">
    <div class="viewer-bar">
      <span class="viewer-count" data-place></span>
      <a class="viewer-original" data-original href="#">Open original <Icon name="external" size={14} /></a>
      <button type="button" class="round" data-close aria-label="Close">
        <Icon name="close" size={18} />
      </button>
    </div>
    <div class="viewer-figure" data-figure></div>
    <p class="viewer-caption" data-caption></p>
    <button type="button" class="round viewer-prev" data-prev aria-label="Previous screenshot">
      <Icon name="arrow-left" size={18} />
    </button>
    <button type="button" class="round viewer-next" data-next aria-label="Next screenshot">
      <Icon name="arrow-right" size={18} />
    </button>
  </dialog>
</section>

<script>
  import '../scripts/showcase.ts';
  import '../scripts/lightbox.ts';
</script>

<style>
  .gallery {
    width: 100%;
    min-width: 0;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: 18px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    scroll-snap-align: start;
    margin: 0;
    padding: clamp(0.5rem, 1.2vw, 0.875rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--deep);
  }
  .slide a {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    background: var(--ink);
    aspect-ratio: 16 / 9;
  }
  .laptop .slide a {
    aspect-ratio: 16 / 10;
  }
  .photo .slide a {
    aspect-ratio: 3 / 2;
  }
  .tablet .slide a {
    aspect-ratio: 7 / 5;
  }
  .classic .slide a {
    aspect-ratio: 4 / 3;
  }
  .slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
  }
  /* With a mouse, a panel with the caption slides in over the picture from
     the left while it is hovered or focused; elsewhere the caption below is
     all there is */
  .over {
    display: none;
  }
  @media (hover: hover) {
    .over {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.75rem;
      width: min(22rem, 48%);
      padding: clamp(1rem, 3vw, 2rem);
      background: color-mix(in srgb, var(--ink) 86%, transparent);
      backdrop-filter: blur(8px);
      color: var(--chrome);
      font-size: var(--step-0);
      font-weight: 600;
      line-height: 1.4;
      translate: -100% 0;
      transition: translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .over-hint {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent, var(--mint));
    }
    .slide a:hover .over,
    .slide a:focus-visible .over {
      translate: 0 0;
    }
    .slide a:focus-visible {
      outline-offset: 3px;
    }
  }
  figcaption {
    padding: 0.75rem 0.375rem 0.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .controls[hidden] {
    display: none;
  }
  button {
    font: inherit;
    color: var(--text);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .round,
  .pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .pause {
    margin-left: auto;
    padding: 0 1rem;
    font-size: var(--step--1);
    font-weight: 500;
  }
  .round:hover,
  .pause:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.75rem;
  }
  .dot span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line-strong);
    transition: width 0.25s ease, background-color 0.25s ease;
  }
  .dot[aria-current='true'] span {
    width: 1.5rem;
    background: var(--accent, var(--mint));
  }

  /* The viewer: the whole screen, the picture as large as fits, the bar
     above it, the caption below, and the arrows at the sides */
  .viewer {
    position: fixed;
    inset: 0;
    display: none;
    grid-template-rows: auto 1fr auto;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0.75rem clamp(0.75rem, 3vw, 2rem) 1rem;
    border: 0;
    background: color-mix(in srgb, var(--ink) 92%, transparent);
    color: var(--text);
    backdrop-filter: blur(12px);
  }
  .viewer[open] {
    display: grid;
  }
  .viewer::backdrop {
    background: transparent;
  }
  .viewer-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
  }
  .viewer-count {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }
  .viewer-original {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
  }
  .viewer-original:hover {
    color: var(--chrome);
  }
  /* The picture is placed within the row, not laid out in it, so its size
     comes from the room the row has and never pushes the caption out */
  .viewer-figure {
    position: relative;
    min-height: 0;
  }
  .viewer-figure :global(img) {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    margin: auto;
    object-fit: contain;
    border-radius: 8px;
  }
  .viewer-caption {
    margin: 0.75rem auto 0;
    max-width: 60ch;
    text-align: center;
    color: var(--chrome);
  }
  .viewer-prev,
  .viewer-next {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    background: color-mix(in srgb, var(--deep) 80%, transparent);
  }
  .viewer-prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .viewer-next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
  @media (max-width: 40rem) {
    .viewer-prev,
    .viewer-next {
      top: auto;
      bottom: 3.5rem;
      translate: none;
    }
    .viewer-caption {
      padding-inline: 3.25rem;
    }
  }
</style>
