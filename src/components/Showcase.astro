---
// A slider of the tools that have screenshots, each slide opening the
// tool's page. Without JavaScript it is a row you swipe or scroll; the
// script adds the buttons, the dots and the timed advance.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { tools } from '../data/tools';

const slides = tools
  .map((tool, i) => ({ tool, number: String(i + 1).padStart(2, '0'), shot: tool.shots[0] }))
  .filter((s) => s.shot);
---
<section class="showcase" aria-roledescription="carousel" aria-label="Tools at a glance" data-showcase>
  <div class="track" data-track>
    {
      slides.map(({ tool, number, shot }, i) => (
        <article
          class="slide"
          data-tool={tool.slug}
          data-cursor="Open"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${tool.name}`}
        >
          <a class="shot" href={`/tools/${tool.slug}/`} tabindex="-1" aria-hidden="true">
            <Image
              src={shot.src}
              alt=""
              widths={[480, 800, 1100]}
              sizes="(max-width: 60rem) 100vw, 36rem"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </a>
          <div class="caption">
            <p class="category">
              {number} / {tool.category}
            </p>
            <p class="name">{tool.name}</p>
            <p class="pitch">{tool.pitch}</p>
            <a class="open" href={`/tools/${tool.slug}/`}>
              Open {tool.name} <Icon name="arrow-right" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <div class="controls" data-controls hidden>
    <button type="button" class="round" data-prev aria-label="Previous tool">
      <Icon name="arrow-left" size={18} />
    </button>
    <div class="dots">
      {
        slides.map(({ tool }, i) => (
          <button type="button" class="dot" data-dot={i} aria-label={`Show ${tool.name}`}>
            <span />
          </button>
        ))
      }
    </div>
    <button type="button" class="round" data-next aria-label="Next tool">
      <Icon name="arrow-right" size={18} />
    </button>
    <button type="button" class="pause" data-pause>Pause</button>
  </div>
</section>

<script>
  import '../scripts/showcase.ts';
</script>

<style>
  .showcase {
    width: 100%;
    min-width: 0;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: 18px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--deep);
    overflow: hidden;
  }
  .shot {
    display: block;
    padding: 0.625rem 0.625rem 0;
  }
  /* Side by side where there is room: the screenshot, then its caption */
  @media (min-width: 48rem) {
    .slide {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(15rem, 1fr);
      align-items: center;
    }
    .shot {
      padding: 0.625rem;
    }
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.125rem 1.375rem 1.25rem;
  }
  .caption p {
    margin: 0;
  }
  .category {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.1;
    color: var(--chrome);
  }
  .pitch {
    font-size: 1rem;
  }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    align-self: flex-start;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .open:hover {
    color: var(--chrome);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .controls[hidden] {
    display: none;
  }
  button {
    font: inherit;
    color: var(--text);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .round,
  .pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .pause {
    margin-left: auto;
    padding: 0 1rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
  }
  .round:hover,
  .pause:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  .dots {
    display: flex;
  }
  .dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.75rem;
  }
  .dot span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line-strong);
    transition: width 0.25s ease, background-color 0.25s ease;
  }
  .dot[aria-current='true'] span {
    width: 1.5rem;
    background: var(--mint);
  }
</style>
