---
import '../styles/global.css';
import '../styles/tools.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logoOnDark from '../assets/brand/logo-on-dark.png';
import logoOnLight from '../assets/brand/logo-on-light.png';
import { tools } from '../data/tools';

interface Props {
  title: string;
  description: string;
  tool?: string;
}
const { title, description, tool } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The copyright runs from the first year to the year of the build
const year = new Date().getFullYear();
const years = year > 2026 ? `2026–${year}` : '2026';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d12" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body data-tool={tool}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Helix Tech home">
          <Image class="on-dark" src={logoOnDark} alt="" height={40} densities={[1, 2]} loading="eager" />
          <Image class="on-light" src={logoOnLight} alt="" height={40} densities={[1, 2]} loading="eager" />
        </a>
        <nav aria-label="Site">
          <a href="/#tools">Tools</a>
          <a href="/#homelab">Homelab</a>
          <a href="https://github.com/Commanderx-code">GitHub <Icon name="external" size={14} /></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <div class="columns">
          <div class="about">
            <p class="name">HELIX TECH</p>
            <p>Tools for your machines, and the homelab behind them.</p>
          </div>
          <nav aria-label="Tools">
            <p class="heading">Tools</p>
            {tools.map((t) => <a href={`/tools/${t.slug}/`}>{t.name}</a>)}
          </nav>
          <nav aria-label="More">
            <p class="heading">More</p>
            <a href="/#homelab">Homelab</a>
            <a href="https://github.com/Commanderx-code">GitHub</a>
          </nav>
        </div>
        <div class="legal">
          <p>
            Built by Helix Tech LLC. The public tools are open source under the MIT license, on{' '}
            <a href="https://github.com/Commanderx-code">GitHub</a>.
          </p>
          <p>© {years} Helix Tech LLC. Helix Tech™ is a trademark of Helix Tech LLC.</p>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/copy.ts';
    </script>
  </body>
</html>

<style>
  .site-head {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.625rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .wordmark :global(img) {
    width: auto;
    height: 2.5rem;
  }
  /* The lettering is pale on dark pages and dark on light ones */
  .wordmark :global(.on-light) {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .wordmark :global(.on-dark) {
      display: none;
    }
    :root:not([data-theme='dark']) .wordmark :global(.on-light) {
      display: block;
    }
  }
  .bar nav {
    display: flex;
    gap: 0.25rem;
  }
  .bar nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .bar nav a:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  @media (max-width: 26rem) {
    .bar nav a {
      padding: 0 0.625rem;
    }
    .wordmark :global(img) {
      height: 1.75rem;
    }
  }

  .site-foot {
    border-top: 1px solid var(--line);
    padding-block: 3rem 2rem;
    font-size: 0.9375rem;
  }
  .columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 4rem;
  }
  .about {
    flex: 1 1 16rem;
  }
  .about p {
    color: var(--muted);
  }
  .about .name {
    margin-bottom: 0.5rem;
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--chrome);
  }
  .site-foot nav {
    display: flex;
    flex-direction: column;
  }
  .site-foot .heading {
    margin-bottom: 0.375rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .site-foot nav a {
    padding-block: 0.25rem;
    color: var(--text);
    text-decoration: none;
  }
  .site-foot nav a:hover {
    color: var(--chrome);
  }
  .legal {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .legal p {
    max-width: none;
    margin-bottom: 0.25rem;
  }
</style>
