---
import '../styles/global.css';
import '../styles/tools.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Helix from '../components/Helix.astro';
import logoOnDark from '../assets/brand/logo-on-dark.png';
import logoOnLight from '../assets/brand/logo-on-light.png';
import { tools } from '../data/tools';
// The two fonts every page shows first, fetched before the stylesheet asks
// for them so the text does not swap and shift
import displayFont from '@fontsource/fira-sans-condensed/files/fira-sans-condensed-latin-800-normal.woff2?url';
import bodyFont from '@fontsource/fira-sans/files/fira-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  tool?: string;
  /** Keep the page out of search results, as for the form's landing page */
  noindex?: boolean;
  /** The picture shown when the page's link is shared; see src/og */
  image?: string;
  /** Structured data for search engines, as a schema.org object */
  jsonLd?: Record<string, unknown>;
  /** No header or footer: the page stands alone, as the coming-soon and maintenance pages do */
  bare?: boolean;
}
const { title, description, tool, noindex = false, image = '/og/home.png', jsonLd, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The copyright runs from the first year to the year of the build
const year = new Date().getFullYear();
const years = year > 2026 ? `2026–${year}` : '2026';

// A few screenshots in the footer, each opening its tool
const gallery = (
  [
    ['toolbox', 4],
    ['boot', 1],
    ['touchdown', 1],
    ['boot', 2],
  ] as const
).flatMap(([slug, n]) => {
  const tool = tools.find((t) => t.slug === slug);
  const shot = tool?.shots[n];
  return tool && shot ? [{ tool, shot }] : [];
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0d12" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Helix Tech releases" href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Helix Tech" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <script is:inline src="/theme.js"></script>
  </head>
  <body data-tool={tool}>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && (
    <header class="site-head" data-header>
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Helix Tech home">
          <Image class="on-dark" src={logoOnDark} alt="" height={40} densities={[1, 2]} loading="eager" />
          <Image class="on-light" src={logoOnLight} alt="" height={40} densities={[1, 2]} loading="eager" />
        </a>
        <nav aria-label="Site">
          <a href="/#tools">Tools</a>
          <a href="/#homelab">Homelab</a>
          <a href="/#faq">FAQ</a>
          <a href="/news/">What’s new</a>
          <a href="https://docs.helixtech.app/">Docs</a>
          <a href="/contact/">Contact</a>
          <a href="https://github.com/Commanderx-code">GitHub <Icon name="external" size={14} /></a>
          <button class="theme" type="button" data-theme-toggle aria-label="Switch theme">
            <span class="sun"><Icon name="sun" size={18} /></span>
            <span class="moon"><Icon name="moon" size={18} /></span>
          </button>
        </nav>
      </div>
    </header>
    )}
    <main id="main">
      <slot />
    </main>
    {!bare && (
    <footer class="site-foot">
      <div class="wrap">
        <section class="cta" aria-labelledby="cta-h" data-reveal>
          <div class="cta-text">
            <p class="eyebrow">Built in the open</p>
            <h2 id="cta-h">Follow along as it grows.</h2>
            <p>New releases, new tools and what’s taking shape, all on GitHub.</p>
          </div>
          <a class="button primary" href="https://github.com/Commanderx-code">
            Follow along on GitHub <Icon name="external" />
          </a>
          <div class="cta-mark">
            <Helix />
          </div>
        </section>

        <div class="grid">
          <div class="brand" data-reveal>
            <Image class="on-dark" src={logoOnDark} alt="Helix Tech" height={36} densities={[1, 2]} />
            <Image class="on-light" src={logoOnLight} alt="Helix Tech" height={36} densities={[1, 2]} />
            <p>Tools for setting up, rescuing and enjoying your machines, and the homelab behind them.</p>
            <p>Built by Helix Tech LLC.</p>
            <a class="brand-link" href="https://github.com/Commanderx-code">
              <Icon name="code" size={18} /> github.com/Commanderx-code
            </a>
          </div>
          <nav aria-label="Tools" data-reveal>
            <p class="heading">Tools</p>
            {
              tools.map((t) => (
                <a href={`/tools/${t.slug}/`}>
                  <Icon name="arrow-right" size={14} />
                  {t.name}
                </a>
              ))
            }
          </nav>
          <nav aria-label="More" data-reveal>
            <p class="heading">More</p>
            <a href="/#homelab"><Icon name="arrow-right" size={14} />Homelab</a>
            <a href="/#faq"><Icon name="arrow-right" size={14} />FAQ</a>
            <a href="/news/"><Icon name="arrow-right" size={14} />What’s new</a>
            <a href="https://docs.helixtech.app/"><Icon name="arrow-right" size={14} />Docs</a>
            <a href="https://status.helixtech.app/"><Icon name="arrow-right" size={14} />Status</a>
            <a href="/contact/"><Icon name="arrow-right" size={14} />Contact</a>
            <a href="/privacy/"><Icon name="arrow-right" size={14} />Privacy</a>
            <a href="/feed.xml"><Icon name="arrow-right" size={14} />RSS feed</a>
            <a href="https://github.com/Commanderx-code"><Icon name="arrow-right" size={14} />GitHub</a>
          </nav>
          <div class="shots" data-reveal>
            <p class="heading">From the tools</p>
            <ul>
              {
                gallery.map(({ tool, shot }) => (
                  <li>
                    <a href={`/tools/${tool.slug}/`} aria-label={tool.name}>
                      <Image src={shot.src} alt="" widths={[240, 400]} sizes="8rem" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="legal">
          <div>
            <p>© {years} Helix Tech LLC. Helix Tech™ is a trademark of Helix Tech LLC.</p>
            <p>The public tools are open source under the MIT license. <a href="/privacy/">Privacy</a></p>
          </div>
          <div class="legal-links">
            <a class="round" href="https://github.com/Commanderx-code" aria-label="Helix Tech on GitHub">
              <Icon name="code" size={18} />
            </a>
            <a class="round" href="#top" aria-label="Back to top">
              <Icon name="arrow-up" size={18} />
            </a>
          </div>
        </div>
      </div>
    </footer>
    )}
    <a class="to-top" href="#top" aria-label="Back to top" data-top>
      <Icon name="arrow-up" size={20} />
    </a>
    <script>
      import '../scripts/copy.ts';
      import '../scripts/motion.ts';
      import '../scripts/theme.ts';
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--ink);
    transition: background-color 0.3s ease;
  }
  /* Once the page scrolls, the header turns frosted and settles lower */
  .site-head[data-scrolled] {
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.625rem;
    transition: padding 0.3s ease;
  }
  [data-scrolled] .bar {
    padding-block: 0.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .wordmark :global(img) {
    width: auto;
    height: 2.5rem;
    transition: height 0.3s ease;
  }
  [data-scrolled] .wordmark :global(img) {
    height: 2.125rem;
  }
  /* The lettering is pale on dark pages and dark on light ones */
  :global(.on-light) {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) :global(.on-dark) {
      display: none;
    }
    :root:not([data-theme='dark']) :global(.on-light) {
      display: block;
    }
  }
  :root[data-theme='light'] :global(.on-dark) {
    display: none;
  }
  :root[data-theme='light'] :global(.on-light) {
    display: block;
  }
  .bar nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .bar nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .bar nav a:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  /* The theme switch: a sun while the page is dark, a moon while it is light.
     Shown only once theme.js has run, since without it the switch does nothing */
  .theme {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    margin-left: 0.25rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  :root[data-theme] .theme {
    display: inline-flex;
  }
  .theme:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  .theme span {
    display: inline-flex;
  }
  .theme .moon,
  :root[data-theme='light'] .theme .sun {
    display: none;
  }
  :root[data-theme='light'] .theme .moon {
    display: inline-flex;
  }
  @media (max-width: 30rem) {
    .bar nav a {
      padding: 0 0.5rem;
    }
    .wordmark :global(img),
    [data-scrolled] .wordmark :global(img) {
      height: 1.75rem;
    }
  }

  .site-foot {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem) 1.5rem;
    background: var(--deep);
    font-size: 0.9375rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .cta-text {
    flex: 1 1 24rem;
  }
  .cta h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
  }
  .cta p:last-child {
    margin: 0;
  }
  .cta-mark {
    flex: none;
    width: 8.5rem;
  }
  @media (max-width: 40rem) {
    .cta-mark {
      display: none;
    }
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(16rem, 1.4fr) repeat(2, minmax(9rem, 0.8fr)) minmax(14rem, 1.2fr);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink);
  }
  .brand :global(img) {
    align-self: flex-start;
    width: auto;
    height: 2.25rem;
    margin-bottom: 0.25rem;
  }
  .brand p {
    margin: 0;
    color: var(--text);
  }
  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--chrome);
    text-decoration: none;
  }
  .brand-link :global(svg) {
    color: var(--mint);
  }
  .brand-link:hover {
    color: var(--mint);
  }
  .heading {
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--mint);
  }
  .grid nav {
    display: flex;
    flex-direction: column;
  }
  .grid nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .grid nav a :global(svg) {
    color: var(--mint);
  }
  .grid nav a:hover {
    color: var(--chrome);
    transform: translateX(3px);
  }
  .shots ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shots a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .shots :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.4s ease;
  }
  .shots a:hover :global(img) {
    transform: scale(1.06);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .legal p {
    max-width: none;
    margin: 0;
  }
  .legal-links {
    display: flex;
    gap: 0.5rem;
  }
  .round {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--text);
  }
  .round:hover {
    color: var(--on-accent);
    background: var(--mint);
    border-color: var(--mint);
  }

  /* Floating back-to-top button, shown once the page has scrolled a screen */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--on-accent);
    background: var(--mint);
    box-shadow: 0 0.75rem 1.5rem -0.5rem rgb(0 0 0 / 0.6);
    opacity: 0;
    translate: 0 1rem;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      translate 0.3s ease,
      scale 0.2s ease;
  }
  .to-top[data-show] {
    opacity: 1;
    translate: none;
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--on-accent);
    scale: 1.08;
  }
</style>
