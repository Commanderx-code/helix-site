---
import '../styles/global.css';
import '../styles/tools.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logoOnDark from '../assets/brand/logo-on-dark.png';
import logoOnLight from '../assets/brand/logo-on-light.png';
import { tools } from '../data/tools';
// The two fonts every page shows first, fetched before the stylesheet asks
// for them so the text does not swap and shift
import displayFont from '@fontsource/fira-sans-condensed/files/fira-sans-condensed-latin-800-normal.woff2?url';
import bodyFont from '@fontsource/fira-sans/files/fira-sans-latin-400-normal.woff2?url';
// Inline, so the theme is on <html> before the first paint without a
// request: the server's Content-Security-Policy allows this script by its
// hash, so its text must not change without the header changing with it
// (see README)
import themeBoot from '../scripts/theme-boot.js?raw';

interface Props {
  title: string;
  description: string;
  tool?: string;
  /** Keep the page out of search results, as for the form's landing page */
  noindex?: boolean;
  /** The picture shown when the page's link is shared; see src/og */
  image?: string;
  /** Structured data for search engines, as a schema.org object */
  jsonLd?: Record<string, unknown>;
  /** No header or footer: the page stands alone, as the coming-soon and maintenance pages do */
  bare?: boolean;
}
const { title, description, tool, noindex = false, image = '/og/home.png', jsonLd, bare = false } = Astro.props;
const path = Astro.url.pathname;
// The footer's subscribe box posts to the same service as the contact form,
// and shows only when that service has a key
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const subscribed = new URL('/contact/subscribed/', Astro.site).href;
const canonical = new URL(path, Astro.site);
// The structured data goes into a <script> element as raw text, so a "<" in
// it, as in a release tag from GitHub, could end the element early and leave
// the rest on the page as markup. Written as \u003c it stays plain JSON.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
// The copyright runs from the first year to the year of the build
const year = new Date().getFullYear();
const years = year > 2026 ? `2026–${year}` : '2026';

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0d12" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Helix Tech releases and posts" href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Helix Tech" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
    <script is:inline set:html={themeBoot} />
  </head>
  <body data-tool={tool}>
    <slot name="backdrop" />
    <a class="skip" href="#main">Skip to content</a>
    {!bare && (
    <header class="site-head" data-header>
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Helix Tech home">
          {/* Lazy, so the one the theme hides is never fetched */}
          <Image class="on-dark" src={logoOnDark} alt="" height={40} densities={[1, 2]} quality={70} />
          <Image class="on-light" src={logoOnLight} alt="" height={40} densities={[1, 2]} quality={70} />
        </a>
        <div class="switches">
          <button class="find" type="button" data-search-open aria-label="Search the site" aria-haspopup="dialog">
            <Icon name="search" size={18} />
          </button>
          <a class="gh" href="https://github.com/Commanderx-code" aria-label="Helix Tech on GitHub">
            <Icon name="github" size={18} />
          </a>
          <button class="theme" type="button" data-theme-toggle aria-label="Switch theme">
            <span class="sun"><Icon name="sun" size={18} /></span>
            <span class="moon"><Icon name="moon" size={18} /></span>
          </button>
          <button class="menu" type="button" data-menu aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
            <span class="open"><Icon name="menu" size={22} /></span>
            <span class="shut"><Icon name="close" size={22} /></span>
          </button>
        </div>
        <nav id="site-nav" aria-label="Site">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <details class="tools-menu" data-tools>
            <summary aria-current={path.startsWith('/tools/') ? 'true' : undefined}>
              Tools <Icon name="chevron-down" size={12} />
            </summary>
            <div class="panel">
              {tools.map((t) => <a href={`/tools/${t.slug}/`}>{t.name}</a>)}
              <hr />
              <a href="/#homelab">Homelab</a>
              <a href="/#faq">FAQ</a>
            </div>
          </details>
          <a href="/posts/" aria-current={path.startsWith('/posts/') ? 'true' : undefined}>Posts</a>
          <a href="/news/" aria-current={path.startsWith('/news/') ? 'page' : undefined}>What’s new</a>
          <a href="https://docs.helixtech.app/">Docs</a>
          <a href="/contact/" aria-current={path.startsWith('/contact/') ? 'true' : undefined}>Contact</a>
        </nav>
      </div>
    </header>
    <dialog class="search" data-search aria-label="Search the site">
      <div class="search-box">
        <form role="search">
          <Icon name="search" size={18} />
          <input type="text" inputmode="search" autofocus enterkeyhint="go" autocomplete="off" placeholder="Search posts, tools and more" aria-label="Search the site" />
          <button type="button" data-search-close aria-label="Close search"><Icon name="close" size={18} /></button>
        </form>
        <p role="status"></p>
        <ol></ol>
      </div>
    </dialog>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && (
    <footer class="site-foot">
      <div class="wrap">
        <div class="grid">
          <div class="brand" data-reveal>
            <Image class="on-dark" src={logoOnDark} alt="Helix Tech" height={36} densities={[1, 2]} />
            <Image class="on-light" src={logoOnLight} alt="Helix Tech" height={36} densities={[1, 2]} />
            <p>Tools for setting up, rescuing and enjoying your machines, and the homelab behind them.</p>
            <ul class="socials">
              <li><a href="https://github.com/Commanderx-code" aria-label="GitHub"><Icon name="github" size={20} /></a></li>
              <li><a href="https://x.com/therevanchistv" aria-label="X"><Icon name="x" size={20} /></a></li>
            </ul>
          </div>
          <nav aria-label="Tools" data-reveal>
            <p class="heading">Tools</p>
            {tools.map((t) => <a href={`/tools/${t.slug}/`}>{t.name}</a>)}
          </nav>
          <nav aria-label="Explore" data-reveal>
            <p class="heading">Explore</p>
            <a href="/#homelab">Homelab</a>
            <a href="/#faq">FAQ</a>
            <a href="/posts/">Posts</a>
            <a href="/news/">What’s new</a>
            <a href="/feed.xml">RSS feed</a>
          </nav>
          <nav aria-label="Support" data-reveal>
            <p class="heading">Support</p>
            <a href="https://docs.helixtech.app/">Docs</a>
            <a href="https://status.helixtech.app/">Status</a>
            <a href="/contact/">Contact</a>
            <a href="https://github.com/Commanderx-code">GitHub</a>
          </nav>
        </div>

        <section class="cta" aria-labelledby="cta-h" data-reveal>
          <div class="cta-text">
            <h2 id="cta-h">Follow along as it grows.</h2>
            <p>New releases, new tools and what’s taking shape, {formKey ? 'by email' : 'all on GitHub'}.</p>
          </div>
          {
            formKey ? (
              <form class="subscribe" method="post" action="https://api.web3forms.com/submit">
                <input type="hidden" name="access_key" value={formKey} />
                <input type="hidden" name="from_name" value="helixtech.app" />
                <input type="hidden" name="subject" value="New subscriber" />
                <input type="hidden" name="redirect" value={subscribed} />
                <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <input type="email" name="email" required autocomplete="email" placeholder="Enter your email address" aria-label="Your email address" />
                <button type="submit">Subscribe</button>
              </form>
            ) : (
              <a class="button primary" href="https://github.com/Commanderx-code">
                Follow along on GitHub <Icon name="external" />
              </a>
            )
          }
        </section>

        <div class="legal">
          <div>
            <p>© {years} Helix Tech LLC. Helix Tech™ is a trademark of Helix Tech LLC.</p>
            <p>The public tools are open source under the MIT license.</p>
          </div>
          <div class="legal-links">
            <a href="/privacy/">Privacy</a>
            <a href="/contact/">Contact</a>
          </div>
        </div>
      </div>
    </footer>
    )}
    <a class="to-top" href="#top" aria-label="Back to top" data-top>
      <Icon name="arrow-up" size={20} />
    </a>
    <script>
      import '../scripts/copy.ts';
      import '../scripts/links.ts';
      import '../scripts/motion.ts';
      import '../scripts/nav.ts';
      import '../scripts/search.ts';
      import '../scripts/theme.ts';
    </script>
  </body>
</html>

<style>
  /* At the top of the page the header is see-through, so a page's backdrop
     (the home page's, in the "backdrop" slot) shows behind it */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  /* Once the page scrolls, the header turns frosted and settles lower */
  .site-head[data-scrolled] {
    border-color: var(--line);
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    backdrop-filter: blur(14px);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.625rem;
    transition: padding 0.3s ease;
  }
  [data-scrolled] .bar {
    padding-block: 0.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .wordmark :global(img) {
    width: auto;
    height: 2.5rem;
    transition: height 0.3s ease;
  }
  [data-scrolled] .wordmark :global(img) {
    height: 2.125rem;
  }
  /* The lettering is pale on dark pages and dark on light ones */
  :global(.on-light) {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) :global(.on-dark) {
      display: none;
    }
    :root:not([data-theme='dark']) :global(.on-light) {
      display: block;
    }
  }
  :root[data-theme='light'] :global(.on-dark) {
    display: none;
  }
  :root[data-theme='light'] :global(.on-light) {
    display: block;
  }
  /* The links sit in a pill in the middle of the bar, the logo on one side of
     it and the switches on the other */
  @media (min-width: 60.01rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      padding-block: 0.75rem;
    }
    [data-scrolled] .bar {
      padding-block: 0.5rem;
    }
  }
  .bar nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--deep);
  }
  .switches {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.25rem;
    order: 3;
  }
  .gh {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 8px;
    color: var(--text);
  }
  .gh:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  /* The smallest phones fit three buttons beside the logo; GitHub is in the footer too */
  @media (max-width: 22rem) {
    .gh {
      display: none;
    }
  }
  .bar nav > a,
  .tools-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: 7px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bar nav > a:hover,
  .tools-menu summary:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  .bar nav > a[aria-current],
  .tools-menu summary[aria-current] {
    color: var(--mint);
    background: var(--raised);
  }
  /* "Tools" opens a menu rather than a page; scripts/nav.ts opens it under the
     mouse and closes it */
  .tools-menu {
    position: relative;
  }
  .tools-menu summary {
    cursor: pointer;
    list-style: none;
  }
  .tools-menu summary::-webkit-details-marker {
    display: none;
  }
  .tools-menu summary :global(svg) {
    transition: rotate 0.2s ease;
  }
  .tools-menu[open] summary :global(svg) {
    rotate: 180deg;
  }
  .panel {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 0;
    z-index: 60;
    display: grid;
    min-width: 15rem;
    padding: 0.375rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--deep);
    box-shadow: 0 1rem 2rem -0.75rem rgb(0 0 0 / 0.6);
  }
  /* Bridges the gap to the pill, so the mouse can cross it */
  .panel::before {
    content: '';
    position: absolute;
    inset: -0.75rem 0 100%;
  }
  .panel a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border-radius: 7px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .panel a:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  .panel hr {
    width: 100%;
    margin: 0.25rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  /* The theme switch: a sun while the page is dark, a moon while it is light.
     Shown only once the theme script has run, since without it the switch does nothing */
  .find,
  .theme,
  .menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  :root[data-theme] .find,
  :root[data-theme] .theme {
    display: inline-flex;
  }
  .find:hover,
  .theme:hover,
  .menu:hover {
    color: var(--chrome);
    background: var(--raised);
  }
  /* The search box over the page. scripts/search.ts opens it and fills the
     list, so what it adds is styled with :global. */
  .search {
    width: min(36rem, 100% - 2rem);
    max-height: min(32rem, 100dvh - 4rem);
    margin: clamp(1rem, 10vh, 6rem) auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--deep);
    color: var(--text);
  }
  .search[open] {
    display: flex;
  }
  .search::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .search-box {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 0.5rem;
  }
  .search form {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.25rem;
    padding-left: 0.75rem;
    border-radius: 10px;
    background: var(--raised);
    color: var(--muted);
  }
  .search form:focus-within {
    outline: 1px solid var(--mint);
  }
  .search input {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    border: 0;
    background: none;
    color: var(--chrome);
    font: inherit;
    outline: none;
  }
  .search input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .search button {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .search button:hover {
    color: var(--chrome);
  }
  .search p {
    flex: none;
    max-width: none;
    margin: 0;
    padding: 0.625rem 0.75rem 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .search ol {
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }
  .search :global(li a) {
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .search :global(li a:hover),
  .search :global(li a:focus-visible) {
    background: var(--raised);
  }
  .search :global(.kind) {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .search :global(.title) {
    font-weight: 600;
    color: var(--chrome);
  }
  .search :global(.summary) {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--step--1);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .theme span,
  .menu span {
    display: inline-flex;
  }
  /* The menu button, on narrow screens only: the links fold into a panel
     under the bar until it is pressed. scripts/nav.ts opens and closes it. */
  .menu .shut,
  .menu[aria-expanded='true'] .open {
    display: none;
  }
  .menu[aria-expanded='true'] .shut {
    display: inline-flex;
  }
  .theme .moon,
  :root[data-theme='light'] .theme .sun {
    display: none;
  }
  :root[data-theme='light'] .theme .moon {
    display: inline-flex;
  }
  @media (max-width: 60rem) {
    .menu {
      display: inline-flex;
    }
    .bar nav {
      display: none;
      order: 4;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.125rem;
      margin-top: 0.5rem;
      padding: 0.5rem 0 0.75rem;
      border: 0;
      border-top: 1px solid var(--line);
      border-radius: 0;
      background: none;
    }
    .site-head[data-open] {
      border-color: var(--line);
      background: var(--ink);
    }
    .site-head[data-open] .bar nav {
      display: flex;
    }
    .bar nav > a,
    .tools-menu summary {
      min-height: 3rem;
      padding: 0 0.75rem;
      font-size: 0.9375rem;
    }
    /* The whole row opens the menu, and the tools open below it, in the flow */
    .tools-menu summary {
      display: flex;
      justify-content: space-between;
    }
    .panel {
      position: static;
      padding: 0 0 0.25rem 0.75rem;
      border: 0;
      background: none;
      box-shadow: none;
    }
    .panel::before {
      content: none;
    }
    .panel a {
      min-height: 3rem;
      font-size: 1.0625rem;
    }
  }
  @media (max-width: 30rem) {
    .wordmark :global(img),
    [data-scrolled] .wordmark :global(img) {
      height: 1.75rem;
    }
  }

  /* A soft glow rises from the foot of the page */
  .site-foot {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem) 1.5rem;
    background:
      radial-gradient(55% 11rem at 50% 100%, color-mix(in srgb, var(--mint) 24%, transparent), transparent),
      var(--deep);
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(16rem, 1.6fr) repeat(3, minmax(8rem, 1fr));
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .brand :global(img) {
    align-self: flex-start;
    width: auto;
    height: 2.25rem;
    margin-bottom: 0.25rem;
  }
  .brand p {
    max-width: 22rem;
    margin: 0;
    color: var(--muted);
  }
  /* Pulled left so the first icon, not its touch area, lines up with the text */
  .socials {
    display: flex;
    margin: 0 0 0 -0.75rem;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--muted);
  }
  .socials a:hover {
    color: var(--mint);
  }
  .heading {
    margin-bottom: 0.75rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chrome);
  }
  .grid nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .grid nav a {
