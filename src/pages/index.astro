---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Showcase from '../components/Showcase.astro';
import Command from '../components/Command.astro';
import Icon from '../components/Icon.astro';
import { tools, latestRelease, repoStats } from '../data/tools';
import { testimonials } from '../data/testimonials';
import { faq } from '../data/faq';
import logo from '../assets/brand/logo-on-dark.png';
// Behind the header and the hero: Helix Boot's menu, blurred and dimmed
// almost to the page colour, so the helix glows through the headline
import sky from '../assets/tools/boot/boot-menu.jpg';
const [releases, stats] = await Promise.all([
  Promise.all(tools.map((t) => latestRelease(t.repo))),
  Promise.all(tools.map((t) => repoStats(t.repo))),
]);

const site = String(Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Helix Tech',
  url: site,
  description: 'Open tools for setting up, rescuing and enjoying your machines.',
  publisher: {
    '@type': 'Organization',
    name: 'Helix Tech LLC',
    url: site,
    logo: new URL(logo.src, Astro.site).href,
    sameAs: ['https://github.com/Commanderx-code'],
  },
};

// The command in the hero is the featured tool's first install entry
const [featured] = tools;
const tryIt = featured.install.find((step) => step.code);

// One word for each tool, typed in turn after "Build. Configure."
const words = ['Optimize.', 'Rescue.', 'Document.', 'Unwind.', 'Score.'];

// Screenshots floating around the headline on wide screens
const shot = (slug: string, n: number) => tools.find((t) => t.slug === slug)?.shots[n];
const floating = [
  { place: 'top-left', depth: 0.12, shot: shot('boot', 1) },
  { place: 'bottom-left', depth: 0.22, shot: shot('toolbox', 1) },
  { place: 'top-right', depth: 0.18, shot: shot('touchdown', 2) },
  { place: 'bottom-right', depth: 0.1, shot: shot('boot', 2) },
].filter((f) => f.shot);

// Numbers read from GitHub at build time; one that could not be read is left
// out, and without any the section is not shown. Stars join once there are
// enough of them to say something.
const known = stats.filter((s) => s !== undefined);
const sum = (key: 'stars' | 'releases' | 'commits' | 'downloads') => known.reduce((n, s) => n + s[key], 0);
const enoughStars = 25;
const figures: { icon: 'download' | 'star' | 'tag' | 'commit' | 'grid'; value: number; label: string }[] = [
  ...(known.length
    ? [
        { icon: 'download' as const, value: sum('downloads'), label: 'Release downloads' },
        { icon: 'tag' as const, value: sum('releases'), label: 'Releases shipped' },
        { icon: 'commit' as const, value: sum('commits'), label: 'Commits on GitHub' },
        ...(sum('stars') >= enoughStars ? [{ icon: 'star' as const, value: sum('stars'), label: 'Stars on GitHub' }] : []),
      ]
    : []),
  { icon: 'grid', value: tools.length, label: 'Tools, one home' },
];
const format = new Intl.NumberFormat('en-US');

const named = (...slugs: string[]) => tools.filter((t) => slugs.includes(t.slug));
const principles = [
  {
    icon: 'list',
    title: 'See the plan first',
    text: 'The Install Plan lists every step with its risk and any password prompt before anything runs, and every command takes --dry-run.',
    tools: named('toolbox'),
  },
  {
    icon: 'shield',
    title: 'Verified downloads',
    text: 'Downloads are checked against the publisher’s checksum, release binaries come with SHA-256 sums, and backups are test-restored.',
    tools: named('boot', 'touchdown', 'toolbox'),
  },
  {
    icon: 'code',
    title: 'Open source',
    text: 'MIT licensed and built in the open on GitHub. Read the code, file an issue, or take what helps.',
    tools: tools.filter((t) => t.repo),
  },
] as const;

const homelab = [
  { icon: 'network', name: 'Networking', stack: 'OPNsense · WireGuard' },
  { icon: 'server', name: 'Self-hosting', stack: 'Docker · ZimaBoard' },
  { icon: 'home', name: 'Home automation', stack: 'Home Assistant · Zigbee' },
  { icon: 'pulse', name: 'Monitoring', stack: 'Uptime Kuma · Checkmk' },
] as const;
---
<Base
  title="Helix Tech: tools for setting up, rescuing and enjoying your machines"
  description="Helix Toolbox, Helix Boot, Config Bible, webOS Launcher and Touchdown: open tools for setting up, rescuing and enjoying your machines."
  jsonLd={jsonLd}
>
  <div class="sky" slot="backdrop" aria-hidden="true">
    <Image src={sky} alt="" widths={[720, 1440]} sizes="100vw" quality={40} loading="eager" />
  </div>
  <section class="hero wrap">
    {
      floating.map((f) => (
        <figure class:list={['float', f.place]} data-reveal={f.place.endsWith('left') ? 'left' : 'right'} aria-hidden="true">
          <div class="drift" data-depth={f.depth}>
            <Image src={f.shot!.src} alt="" widths={[320, 560]} sizes="16rem" />
          </div>
        </figure>
      ))
    }
    <div class="pitch">
      <p class="eyebrow" data-reveal>Independent tools · one home</p>
      <h1 data-reveal>
        <span class="visually-hidden">Build. Configure. Optimize.</span>
        <span aria-hidden="true">
          Build. Configure.<br />
          <span class="lit"><span data-typed={words.join('|')}>{words[0]}</span></span><span class="caret"></span>
        </span>
      </h1>
      <p class="lede" data-reveal>
        Tools for setting up, rescuing and enjoying your machines: a Linux setup toolbox, a rescue USB that builds itself, a
        handbook for your own workstation, a home screen for LG TVs and a scoreboard for the terminal.
      </p>
      <p class="actions" data-reveal>
        <a class="button primary" href="#tools">Explore the tools <Icon name="arrow-down" /></a>
        <a class="button" href="https://github.com/Commanderx-code">Visit GitHub <Icon name="external" /></a>
      </p>
      {
        tryIt?.code && (
          <div class="try" data-reveal>
            <p>{featured.name}: {tryIt.title.toLowerCase()}</p>
            <Command code={tryIt.code} label={`${featured.name}: ${tryIt.title}`} />
          </div>
        )
      }
    </div>
  </section>

  <div class="wrap laptop-wrap" data-reveal="zoom">
    <div class="laptop">
      <div class="screen" data-dark>
        <Showcase />
      </div>
      <div class="base" aria-hidden="true"></div>
    </div>
  </div>

  {
    known.length > 0 && (
      <section class="wrap stats" aria-label="Helix Tech in numbers">
        <ul>
          {figures.map((f) => (
            <li data-reveal="zoom">
              <Icon name={f.icon} size={26} />
              <span class="figure" data-count={f.value}>
                {format.format(f.value)}
              </span>
              <span class="figure-label">{f.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="tools" class="band" aria-labelledby="tools-h">
    <div class="wrap">
      <div class="section-head" data-reveal="left">
        <div>
          <p class="eyebrow">The tools</p>
          <h2 id="tools-h">Tools with a purpose.</h2>
        </div>
        <p>Different tools, connected by the same curiosity for making technology more useful.</p>
      </div>

      <div class="bento">
        {
          tools.map((tool, i) => {
            const release = releases[i];
            const [lead] = tool.shots;
            return (
              <article class:list={['card', { featured: i === 0 }]} data-reveal={i === 0 ? 'left' : 'zoom'} data-cursor="Open">
                <div class="card-text">
                  <div class="card-top">
                    {tool.icon && <Image src={tool.icon} alt="" width={44} height={44} class="icon" />}
                    <span class="category">
                      {String(i + 1).padStart(2, '0')} / {tool.category}
                    </span>
                  </div>
                  <h3>
                    <a href={`/tools/${tool.slug}/`}>{tool.name}</a>
                  </h3>
                  <p>{tool.pitch}</p>
                  <ul class="chips">
                    {release && <li>Version {release.tag.replace(/^v/, '')}</li>}
                    {tool.availability && <li class="private">Not public yet</li>}
                    {tool.license && <li>{tool.license}</li>}
                  </ul>
                  {!lead && tool.highlights && (
                    <ul class="highlights">
                      {tool.highlights.map((h) => (
                        <li>
                          <Icon name="check" size={18} />
                          {h}
                        </li>
                      ))}
                    </ul>
                  )}
                  {lead && i > 0 && (
                    <Image
                      class="shot"
                      data-reveal="zoom"
                      src={lead.src}
                      alt={lead.alt}
                      widths={[480, 800]}
                      sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 24rem"
                    />
                  )}
                  <p class="links">
                    <a href={`/tools/${tool.slug}/`}>
                      {tool.install.length ? 'Features and install' : 'Features'}
                      <span class="visually-hidden"> for {tool.name}</span>
                      <Icon name="arrow-right" />
                    </a>
                    {tool.repo && (
                      <a class="quiet" href={`https://github.com/${tool.repo}`}>
                        GitHub<span class="visually-hidden">: {tool.name}</span> <Icon name="external" size={14} />
                      </a>
                    )}
                  </p>
                </div>
                {lead && i === 0 && (
                  <Image class="shot" data-reveal="right" src={lead.src} alt={lead.alt} widths={[480, 800, 1100]} sizes="(max-width: 64rem) 100vw, 40rem" />
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="band tint" aria-labelledby="how-h">
    <div class="wrap">
      <div data-reveal="left">
        <p class="eyebrow">How they work</p>
        <h2 id="how-h">Careful by design.</h2>
      </div>
      <div class="trio">
        {
          principles.map((p) => (
            <div class="principle" data-reveal>
              <div class="card">
                <div class="face front">
                  <Icon name={p.icon} size={32} />
                  <h3>{p.title}</h3>
                  <p class="hint" aria-hidden="true">
                    Flip <Icon name="arrow-right" size={14} />
                  </p>
                </div>
                <div class="face back">
                  <p>{p.text}</p>
                  <ul class="chips">
                    {p.tools.map((t) => (
                      <li>
                        <a href={`/tools/${t.slug}/`}>{t.name}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="band" aria-labelledby="praise-h">
        <div class="wrap">
          <div data-reveal="left">
            <p class="eyebrow">In their words</p>
            <h2 id="praise-h">What people are saying.</h2>
          </div>
          <ul class="praise">
            {testimonials.map((t) => {
              const about = t.tool && tools.find((x) => x.slug === t.tool);
              return (
                <li data-reveal="zoom">
                  <figure>
                    <blockquote>
                      <p>{t.quote}</p>
                    </blockquote>
                    <figcaption>
                      <span class="avatar" aria-hidden="true">
                        {t.name.charAt(0)}
                      </span>
                      <span>
                        <span class="who">{t.name}</span>
                        {(t.role || about) && (
                          <span class="role">
                            {t.role}
                            {t.role && about && ' · '}
                            {about && <a href={`/tools/${about.slug}/`}>{about.name}</a>}
                          </span>
                        )}
                      </span>
                    </figcaption>
                  </figure>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section id="homelab" class="band" aria-labelledby="lab-h">
    <div class="wrap split">
      <div data-reveal="left">
        <p class="eyebrow">The homelab</p>
        <h2 id="lab-h">Learning by building.</h2>
        <p>
          The Helix Tech homelab is where networking, self-hosted services and home automation come together, and where the
          tools are put to work.
        </p>
      </div>
      <ul class="lab">
        {
          homelab.map((row) => (
            <li data-reveal="right">
              <Icon name={row.icon} size={24} />
              <span class="lab-name">{row.name}</span>
              <span class="lab-stack">{row.stack}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="faq" class="band tint" aria-labelledby="faq-h">
    <div class="wrap split faq">
      <div data-reveal="left">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Asked and answered.</h2>
        <p>
          Something not covered here? Open an issue on the tool’s GitHub page, or <a href="/contact/">get in touch</a>.
        </p>
      </div>
      <div class="answers">
        {
          faq.map((q, i) => (
            <details name="faq" open={i === 0} data-reveal="right">
              <summary>
                <span>{q.question}</span>
                <span class="sign" aria-hidden="true">
                  <Icon name="plus" size={18} />
                </span>
              </summary>
              <p>{q.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* The backdrop fills the first screen, behind the see-through header and
     the hero, and fades into the page colour before the showcase. It is
     solid page colour behind the header, so the bar never takes its tint. */
  .sky {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(100vh, 60rem);
    overflow: hidden;
    pointer-events: none;
  }
  .sky :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The helix in the right half of the shot, zoomed in so the menu's
       text is out of frame and only colour and light remain */
    object-position: 72% 45%;
    filter: blur(5px) saturate(1.2);
    scale: 1.6;
  }
  .sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 45%, transparent, color-mix(in srgb, var(--ink) 40%, transparent)),
      linear-gradient(
        to bottom,
        var(--ink),
        color-mix(in srgb, var(--ink) 34%, transparent) 9rem,
        color-mix(in srgb, var(--ink) 46%, transparent) 55%,
        var(--ink)
      );
  }

  /* The headline, centred, with screenshots floating around it on wide screens */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 9vw, 7.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .pitch {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    margin-bottom: 1.5rem;
  }
  .lit {
    background: linear-gradient(90deg, var(--mint), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.8em;
    margin-left: 0.06em;
    background: var(--mint);
    vertical-align: -0.04em;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    max-width: 38em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .try {
    width: 100%;
    max-width: 40rem;
    text-align: left;
  }
  .try p {
    margin-bottom: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .try :global(pre) {
    white-space: pre;
  }

  .float {
    display: none;
    position: absolute;
    width: 15rem;
    margin: 0;
  }
  .drift {
    transform: translate3d(0, calc(var(--drift, 0px) * -1), 0) rotate(var(--tilt));
  }
  .float :global(img) {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.6);
  }
  .top-left { top: 4rem; left: -3rem; --tilt: -7deg; }
  .bottom-left { bottom: 3rem; left: 0; --tilt: 5deg; }
  .top-right { top: 5rem; right: -3rem; --tilt: 6deg; }
  .bottom-right { bottom: 2rem; right: 0; --tilt: -5deg; }
  @media (min-width: 80rem) {
    .float {
      display: block;
    }
  }

  /* The slider in a laptop */
  .laptop-wrap {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .laptop {
    max-width: 66rem;
    margin-inline: auto;
  }
  .screen {
    padding: clamp(0.5rem, 1.4vw, 1rem);
    border: 1px solid var(--line-strong);
    border-radius: 22px 22px 0 0;
    background: #05060a;
  }
  .screen :global(.track),
  .screen :global(.slide) {
    border-radius: 12px;
  }
  .screen :global(.controls) {
    padding-inline: 0.25rem;
  }
  .base {
    height: clamp(0.75rem, 1.6vw, 1.25rem);
    margin-inline: -4%;
    border: 1px solid var(--line-strong);
    border-radius: 0 0 18px 18px;
    background: linear-gradient(var(--raised), var(--deep));
  }

  .stats ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1rem;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
  }
  .stats li > :global(svg) {
    margin-bottom: 0.5rem;
    color: var(--mint);
  }
  .figure {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    color: var(--chrome);
    font-variant-numeric: tabular-nums;
  }
  .figure-label {
    color: var(--muted);
  }

  .band {
    border-top: 1px solid var(--line);
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .tint {
    background: var(--deep);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head > p {
    max-width: 26em;
    margin: 0;
    color: var(--muted);
  }

  /* Six columns: the first tool takes four, the rest two. Fewer as the screen narrows. */
  /* A card's screenshot arrives a beat after the card itself */
  .card :global(.shot[data-reveal]) {
    transition-delay: calc(var(--reveal-order, 0) * 160ms + 300ms);
  }
  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .card {
    position: relative;
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  /* The whole card opens the tool: grows a little under the pointer, gives under a press */
  @media (hover: hover) {
    .card:hover {
      z-index: 1;
      border-color: var(--mint);
      transform: scale(1.02);
      box-shadow: 0 1.25rem 2.5rem -1.5rem rgb(0 0 0 / 0.5);
    }
  }
  .card:active {
    transform: scale(0.985);
    transition-duration: 0.08s;
  }
  .card:has(h3 a:focus-visible) {
    border-color: var(--mint);
  }
  .card.featured {
    grid-column: span 4;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
  }
  .card-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .featured .card-text {
    flex: 1 1 16rem;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }
  .card .icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
  }
  .category {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card h3 {
    margin: 0;
    font-size: 1.625rem;
  }
  .featured h3 {
    font-size: 1.875rem;
  }
  .card h3 a {
    color: var(--chrome);
    text-decoration: none;
  }
  .card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card h3 a:focus-visible {
    outline: none;
  }
  .card:hover h3 a {
    color: var(--mint);
  }
  .card p {
    margin: 0;
  }
  .private {
    color: var(--violet);
  }
  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }
  .highlights li {
    display: flex;
    gap: 0.625rem;
  }
  .highlights :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--mint);
  }
  .card .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: auto;
  }
  .links a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .links a.quiet {
    color: var(--text);
  }
  .links a:hover {
    color: var(--chrome);
  }
  .card :global(.shot) {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }
  .featured :global(.shot) {
    flex: 1.4 1 20rem;
    min-width: 0;
    width: auto;
  }
  @media (max-width: 64rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card {
      grid-column: span 1;
    }
    .card.featured {
      grid-column: span 2;
    }
  }
  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
