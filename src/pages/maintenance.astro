---
// The page the server shows while the site is being worked on. Built with
// the rest of the site, served in place of every page when the server's
// maintenance switch is on; see README.
import Base from '../layouts/Base.astro';
import Standby from '../components/Standby.astro';
import Icon from '../components/Icon.astro';
import { tools } from '../data/tools';

const onGitHub = tools.filter((t) => t.repo);
---
<Base
  title="Back in a moment: Helix Tech"
  description="The Helix Tech site is being worked on. The tools and their downloads stay available on GitHub."
  noindex
  bare
>
  <Standby eyebrow="Maintenance" title="Back in a moment.">
    <p class="lede" data-reveal>
      The site is being worked on and will be back shortly. Nothing is wrong on your side, and nothing you have is affected.
    </p>
    <div class="meanwhile" data-reveal>
      <p class="heading">Meanwhile, the tools are where they always are</p>
      <ul>
        {
          onGitHub.map((t) => (
            <li data-tool={t.slug}>
              <a href={`https://github.com/${t.repo}/releases/latest`}>
                {t.name} <Icon name="external" size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="actions" data-reveal>
      <a class="button primary" href="/">Try again <Icon name="arrow-right" /></a>
      <a class="button" href="https://github.com/Commanderx-code">GitHub <Icon name="external" size={14} /></a>
    </p>
  </Standby>
</Base>

<style>
  .lede {
    margin-bottom: 1.75rem;
    font-size: var(--step-1);
    color: var(--muted);
  }
  .heading {
    margin: 0 0 0.75rem;
    font-weight: 600;
    color: var(--chrome);
  }
  .meanwhile {
    margin-bottom: 2rem;
  }
  .meanwhile ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .meanwhile a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .meanwhile a:hover {
    border-color: var(--accent, var(--mint));
    color: var(--accent, var(--mint));
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    max-width: none;
  }
</style>
