---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found: Helix Tech" description="This page does not exist.">
  <section class="wrap missing">
    <p class="eyebrow" data-reveal>404</p>
    <h1 data-reveal>This page does not exist.</h1>
    <p data-reveal>The address may be mistyped, or the page has moved. Every tool is listed on the home page.</p>
    <p data-reveal><a class="button primary" href="/#tools">See all the tools <Icon name="arrow-right" /></a></p>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(4rem, 10vw, 8rem) 2rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
