---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import Icon from '../../components/Icon.astro';
import { tools, latestRelease, type Tool } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const release = await latestRelease(tool.repo);
const repoUrl = tool.repo && `https://github.com/${tool.repo}`;
const released =
  release &&
  new Date(release.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const [lead, ...rest] = tool.shots;
const index = tools.indexOf(tool);
const next = tools[(index + 1) % tools.length];
---
<Base title={`${tool.name}: ${tool.pitch}`} description={`${tool.pitch} ${tool.summary}`} tool={tool.slug}>
  <article class="tool">
    <header class="head wrap">
      <nav aria-label="Breadcrumb">
        <ol>
          <li><a href="/#tools">Tools</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{tool.name}</li>
        </ol>
      </nav>

      <div class="title">
        {tool.icon && <Image src={tool.icon} alt="" width={72} height={72} class="icon" />}
        <div>
          <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {tool.category}</p>
          <h1>{tool.name}</h1>
        </div>
      </div>
      <p class="pitch">{tool.pitch}</p>
      <p class="summary">{tool.summary}</p>
      <ul class="chips">
        {release && <li class="version">Version {release.tag.replace(/^v/, '')}</li>}
        {tool.availability && <li class="version">Not public yet</li>}
        {tool.license && <li>{tool.license}</li>}
      </ul>

      {
        repoUrl ? (
          <p class="actions">
            {release ? (
              <a class="button primary" href={release.url}>
                Download {release.tag}
              </a>
            ) : (
              tool.install.length > 0 && (
                <a class="button primary" href="#install">
                  Install <Icon name="arrow-down" />
                </a>
              )
            )}
            {release && tool.install.length > 0 && <a class="button" href="#install">Install</a>}
            <a class="button" href={repoUrl}>
              Source on GitHub <Icon name="external" />
            </a>
            {tool.docs && (
              <a class="button" href={tool.docs}>
                Documentation <Icon name="external" />
              </a>
            )}
          </p>
        ) : (
          <p class="notice">{tool.availability}</p>
        )
      }
    </header>

    {
      lead && (
        <section class="shots wrap" aria-label="Screenshots">
          <figure class="lead">
            <a href={lead.src.src}>
              <Image src={lead.src} alt={lead.alt} widths={[640, 1100, 1600]} sizes="(max-width: 75rem) 100vw, 75rem" />
            </a>
            <figcaption>{lead.alt}</figcaption>
          </figure>
          {rest.length > 0 && (
            <ul class="thumbs">
              {rest.map((s) => (
                <li>
                  <a href={s.src.src}>
                    <Image src={s.src} alt={s.alt} widths={[400, 640]} sizes="(max-width: 40rem) 50vw, 18rem" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <section class="band" aria-labelledby="features-h">
      <div class="wrap body">
        <div class="features">
          <h2 id="features-h">What it does</h2>
          <ul>
            {
              tool.features.map((f) => (
                <li>
                  <Icon name="check" size={20} />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
        <aside aria-labelledby="requirements-h">
          <h2 id="requirements-h" class="visually-hidden">Requirements</h2>
          <dl>
            <dt>Runs on</dt>
            <dd>{tool.platforms}</dd>
            {
              tool.license && (
                <>
                  <dt>License</dt>
                  <dd>{tool.license}</dd>
                </>
              )
            }
            {
              release && (
                <>
                  <dt>Latest release</dt>
                  <dd>
                    <a href={release.url}>{release.tag}</a>, {released}
                  </dd>
                </>
              )
            }
          </dl>
          {
            tool.docs && (
              <a class="docs" href={tool.docs}>
                Read the documentation <Icon name="external" size={14} />
              </a>
            )
          }
        </aside>
      </div>
    </section>

    {
      tool.install.length > 0 && (
        <section id="install" class="band tint" aria-labelledby="install-h">
          <div class="wrap">
            <h2 id="install-h">Install</h2>
            <div class="steps">
              {tool.install.map((step) => (
                <div class="step">
                  <h3>{step.title}</h3>
                  {step.note && <p>{step.note}</p>}
                  {step.code && <Command code={step.code} label={step.title} />}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <nav class="wrap next-wrap" aria-label="Next tool">
      <a class="next" href={`/tools/${next.slug}/`} data-tool={next.slug}>
        {next.icon && <Image src={next.icon} alt="" width={48} height={48} class="next-icon" />}
        <span class="next-text">
          <span class="next-label">Next tool</span>
          <span class="next-name">{next.name}</span>
          <span>{next.pitch}</span>
        </span>
        <Icon name="arrow-right" size={28} />
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }
  ol a {
    color: var(--text);
    text-decoration: none;
  }
  ol a:hover {
    color: var(--chrome);
  }
  [aria-current='page'] {
    color: var(--chrome);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 1.125rem;
  }
  .title .eyebrow {
    margin-bottom: 0.25rem;
    color: var(--accent);
  }
  .title h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .icon {
    width: clamp(3.5rem, 6vw, 4.5rem);
    height: auto;
    border-radius: 16px;
    flex: none;
  }
  .pitch {
    margin: 1.25rem 0 0.75rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--chrome);
  }
  .summary {
    max-width: 40em;
  }
  .version {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--chrome);
  }
  .version::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    max-width: none;
  }
  .notice {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--deep);
  }

  .shots {
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  figure {
    margin: 0;
    padding: clamp(0.5rem, 1.2vw, 0.875rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--deep);
  }
  figure :global(img),
  .thumbs :global(img) {
    width: 100%;
    border-radius: 10px;
  }
  figcaption {
    padding: 0.75rem 0.375rem 0.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .thumbs {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .thumbs a {
    display: block;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--deep);
  }
  .thumbs a:hover {
    border-color: var(--accent);
  }

  .band {
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .tint {
    background: var(--deep);
  }
  .band h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.5rem;
  }
  .features {
    flex: 999 1 34rem;
    min-width: 0;
  }
  .features ul {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--deep);
    font-size: 1rem;
  }
  .features :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  aside {
    flex: 1 1 17rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--deep);
  }
  dl {
    margin: 0;
  }
  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0.25rem 0 1.25rem;
    font-size: 0.9375rem;
  }
  .docs {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .steps {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
  }
  .step {
    min-width: 0;
  }
  .step h3 {
    margin-bottom: 0.5rem;
    font-family: var(--body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: 0;
  }
  .step p {
    margin-bottom: 0.75rem;
  }

  .next-wrap {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
    color: var(--text);
    text-decoration: none;
  }
  .next:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .next > :global(svg) {
    color: var(--accent);
  }
  .next :global(.next-icon) {
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
  }
  .next-text {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
  }
  .next-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .next-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.625rem;
    color: var(--chrome);
  }
</style>
