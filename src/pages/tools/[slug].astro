---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import Icon from '../../components/Icon.astro';
import Notes from '../../components/Notes.astro';
import { tools, latestRelease, releaseNotes, type Tool } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const [release, notes] = await Promise.all([latestRelease(tool.repo), releaseNotes(tool.repo, 3)]);
const when = (date: string) =>
  new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const repoUrl = tool.repo && `https://github.com/${tool.repo}`;
const released = release && when(release.date);
const [lead, ...rest] = tool.shots;
const index = tools.indexOf(tool);
const next = tools[(index + 1) % tools.length];

// What search engines may show about the tool
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: `${tool.pitch} ${tool.summary}`,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(`/og/${tool.slug}.png`, Astro.site).href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: tool.platforms,
  ...(release && { softwareVersion: release.tag.replace(/^v/, ''), downloadUrl: release.url, dateModified: release.date }),
  ...(tool.license === 'MIT' && { license: 'https://opensource.org/license/mit' }),
  ...(lead && { screenshot: new URL(lead.src.src, Astro.site).href }),
  ...(repoUrl && { sameAs: repoUrl }),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Helix Tech LLC', url: String(Astro.site) },
};
---
<Base
  title={`${tool.name}: ${tool.pitch}`}
  description={`${tool.pitch} ${tool.summary}`}
  tool={tool.slug}
  image={`/og/${tool.slug}.png`}
  jsonLd={jsonLd}
>
  <article class="tool">
    <header class="head wrap">
      <nav aria-label="Breadcrumb" data-reveal>
        <ol>
          <li><a href="/#tools">Tools</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{tool.name}</li>
        </ol>
      </nav>

      <div class="title" data-reveal>
        {tool.icon && <Image src={tool.icon} alt="" width={72} height={72} class="icon" />}
        <div>
          <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {tool.category}</p>
          <h1>{tool.name}</h1>
        </div>
      </div>
      <p class="pitch" data-reveal>{tool.pitch}</p>
      <p class="summary" data-reveal>{tool.summary}</p>
      <ul class="chips" data-reveal>
        {release && <li class="version">Version {release.tag.replace(/^v/, '')}</li>}
        {tool.availability && <li class="version">Not public yet</li>}
        {tool.license && <li>{tool.license}</li>}
      </ul>

      {
        repoUrl ? (
          <p class="actions" data-reveal>
            {release ? (
              <a class="button primary" href={release.url}>
                Download {release.tag}
              </a>
            ) : (
              tool.install.length > 0 && (
                <a class="button primary" href="#install">
                  Install <Icon name="arrow-down" />
                </a>
              )
            )}
            {release && tool.install.length > 0 && <a class="button" href="#install">Install</a>}
            <a class="button" href={repoUrl}>
              Source on GitHub <Icon name="external" />
            </a>
            {tool.docs && (
              <a class="button" href={tool.docs}>
                Documentation <Icon name="external" />
              </a>
            )}
          </p>
        ) : (
          <p class="notice" data-reveal>{tool.availability}</p>
        )
      }
    </header>

    {
      lead && (
        <section class="shots wrap" aria-label="Screenshots">
          <figure class="lead" data-reveal="zoom">
            <a href={lead.src.src}>
              <Image src={lead.src} alt={lead.alt} widths={[640, 1100, 1600]} sizes="(max-width: 75rem) 100vw, 75rem" />
            </a>
            <figcaption>{lead.alt}</figcaption>
          </figure>
          {rest.length > 0 && (
            <ul class="thumbs">
              {rest.map((s) => (
                <li data-reveal>
                  <a href={s.src.src}>
                    <Image src={s.src} alt={s.alt} widths={[400, 640]} sizes="(max-width: 40rem) 50vw, 18rem" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <section class="band" aria-labelledby="features-h">
      <div class="wrap body">
        <div class="features" data-reveal="left">
          <h2 id="features-h">What it does</h2>
          <ul>
            {
              tool.features.map((f) => (
                <li>
                  <Icon name="check" size={20} />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
        <aside aria-labelledby="requirements-h" data-reveal="right">
          <h2 id="requirements-h" class="visually-hidden">Requirements</h2>
          <dl>
            <dt>Runs on</dt>
            <dd>{tool.platforms}</dd>
            {
              tool.license && (
                <>
                  <dt>License</dt>
                  <dd>{tool.license}</dd>
                </>
              )
            }
            {
              release && (
                <>
                  <dt>Latest release</dt>
                  <dd>
                    <a href={release.url}>{release.tag}</a>, {released}
                  </dd>
                </>
              )
            }
          </dl>
          {
            tool.docs && (
              <a class="docs" href={tool.docs}>
                Read the documentation <Icon name="external" size={14} />
              </a>
            )
          }
        </aside>
      </div>
    </section>

    {
      tool.install.length > 0 && (
        <section id="install" class="band tint" aria-labelledby="install-h">
          <div class="wrap">
            <h2 id="install-h" data-reveal="left">Install</h2>
            <div class="steps">
              {tool.install.map((step) => (
                <div class="step" data-reveal>
                  <h3>{step.title}</h3>
                  {step.note && <p>{step.note}</p>}
                  {step.code && <Command code={step.code} label={step.title} />}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="band" aria-labelledby="releases-h">
          <div class="wrap">
            <div class="section-head" data-reveal="left">
              <h2 id="releases-h">Recent releases</h2>
              <p>
                <a href="/news/">
                  Every tool's releases <Icon name="arrow-right" size={14} />
                </a>
                <a href={`${repoUrl}/releases`}>
                  All on GitHub <Icon name="external" size={14} />
                </a>
              </p>
            </div>
            <ol class="releases">
              {notes.map((r, i) => (
                <li class="release" data-reveal>
                  <details open={i === 0}>
                    <summary>
                      <span class="tag">{r.tag}</span>
                      <span class="release-name">{r.name !== r.tag ? r.name : ''}</span>
                      {r.prerelease && <span class="pre">Pre-release</span>}
                      <time datetime={r.date}>{when(r.date)}</time>
                      <Icon name="arrow-down" size={18} />
                    </summary>
                    <div class="release-body">
                      <Notes markdown={r.body} />
                      <p class="links">
                        <a href={r.url}>
                          {r.tag} on GitHub <Icon name="external" size={14} />
                        </a>
                      </p>
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <nav class="wrap next-wrap" aria-label="Next tool" data-reveal="zoom">
      <a class="next" href={`/tools/${next.slug}/`} data-tool={next.slug}>
        {next.icon && <Image src={next.icon} alt="" width={48} height={48} class="next-icon" />}
        <span class="next-text">
          <span class="next-label">Next tool</span>
          <span class="next-name">{next.name}</span>
          <span>{next.pitch}</span>
        </span>
        <Icon name="arrow-right" size={28} />
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }
  ol a {
    color: var(--text);
    text-decoration: none;
  }
  ol a:hover {
    color: var(--chrome);
  }
  [aria-current='page'] {
    color: var(--chrome);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 1.125rem;
  }
  .title .eyebrow {
    margin-bottom: 0.25rem;
    color: var(--accent);
  }
  .title h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .icon {
    width: clamp(3.5rem, 6vw, 4.5rem);
    height: auto;
    border-radius: 16px;
    flex: none;
  }
  .pitch {
    margin: 1.25rem 0 0.75rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--chrome);
  }
  .summary {
    max-width: 40em;
  }
  .version {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--chrome);
  }
  .version::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    max-width: none;
  }
  .notice {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--deep);
  }

  .shots {
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  figure {
    margin: 0;
    padding: clamp(0.5rem, 1.2vw, 0.875rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--deep);
  }
  figure :global(img),
  .thumbs :global(img) {
    width: 100%;
    border-radius: 10px;
  }
  figcaption {
    padding: 0.75rem 0.375rem 0.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .thumbs {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .thumbs a {
    display: block;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--deep);
  }
  .thumbs a {
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  @media (hover: hover) {
    .thumbs a:hover {
      border-color: var(--accent);
      transform: scale(1.04);
    }
  }
  .thumbs a:active {
    transform: scale(0.97);
    transition-duration: 0.08s;
  }

  .band {
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .tint {
    background: var(--deep);
  }
  .band h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.5rem;
  }
  .features {
    flex: 999 1 34rem;
    min-width: 0;
  }
  .features ul {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--deep);
    font-size: 1rem;
  }
  .features :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  aside {
    flex: 1 1 17rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--deep);
  }
  dl {
    margin: 0;
  }
  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0.25rem 0 1.25rem;
    font-size: 0.9375rem;
  }
  .docs {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .steps {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
  }
  .step {
    min-width: 0;
  }
  .step h3 {
    margin-bottom: 0.5rem;
    font-family: var(--body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: 0;
  }
  .step p {
    margin-bottom: 0.75rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .section-head h2,
  .section-head p {
    margin: 0;
  }
  .section-head p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--step--1);
  }
  .section-head a,
  .release-body .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    color: var(--accent, var(--mint));
    text-decoration: none;
  }
  .section-head a:hover,
  .release-body .links a:hover {
    color: var(--chrome);
  }
  .releases {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .release details {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
  }
  .release details[open] {
    border-color: var(--line-strong);
  }
  .release summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .release summary::-webkit-details-marker {
    display: none;
  }
  .release summary > :global(svg) {
    margin-left: auto;
    color: var(--muted);
    transition: rotate 0.25s ease;
  }
  .release details[open] summary > :global(svg) {
    rotate: 180deg;
  }
  .tag {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent, var(--mint));
  }
  .release-name {
    font-weight: 600;
    color: var(--chrome);
  }
  .release-name:empty {
    display: none;
  }
  .pre {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .release time {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .release-body {
    padding: 0 1.25rem 1rem;
  }

  .next-wrap {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
    color: var(--text);
    text-decoration: none;
  }
  .next {
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  @media (hover: hover) {
    .next:hover {
      border-color: var(--accent);
      color: var(--text);
      transform: scale(1.015);
    }
  }
  .next:active {
    transform: scale(0.985);
    transition-duration: 0.08s;
  }
  .next > :global(svg) {
    color: var(--accent);
  }
  .next :global(.next-icon) {
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
  }
  .next-text {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
  }
  .next-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .next-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.625rem;
    color: var(--chrome);
  }
</style>
