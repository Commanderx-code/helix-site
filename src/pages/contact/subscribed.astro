---
// Where the footer's subscribe box lands after Web3Forms has taken the address
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Subscribed: Helix Tech" description="Your address is on the Helix Tech email list." noindex>
  <section class="wrap sent">
    <p class="eyebrow" data-reveal>Subscribed</p>
    <h1 data-reveal>You’re on the list.</h1>
    <p data-reveal>Thanks. News of releases and new tools will come from contact@helixstack.io.</p>
    <p data-reveal><a class="button primary" href="/">Back to the home page <Icon name="arrow-right" /></a></p>
  </section>
</Base>

<style>
  .sent {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(4rem, 8vw, 7rem);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
