---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allPosts, postDate, readingMinutes } from '../../data/posts';
import { tools } from '../../data/tools';

export async function getStaticPaths() {
  return (await allPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, categories, image, imageAlt, tool: slug } = post.data;
const { Content, headings } = await render(post);
const contents = headings.filter((h) => h.depth === 2);
const tool = tools.find((t) => t.slug === slug);

const site = String(Astro.site);
const share = `/og/${post.id}.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  image: new URL(share, site).href,
  mainEntityOfPage: new URL(`/posts/${post.id}/`, site).href,
  author: { '@type': 'Organization', name: 'Helix Tech LLC', url: site },
  publisher: { '@type': 'Organization', name: 'Helix Tech LLC', url: site },
};
---
<Base title={`${title} | Helix Tech`} description={description} tool={slug} image={share} jsonLd={jsonLd}>
  <article class="wrap post">
    <header>
      <p class="back">
        <a href="/posts/"><Icon name="arrow-left" size={14} /> All posts</a>
      </p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{postDate(date)}</time> · {readingMinutes(post.body)} min read
      </p>
      <ul class="chips">
        {categories.map((category) => <li>{category}</li>)}
      </ul>
    </header>

    <Image class="lead" src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 50rem) 100vw, 46rem" loading="eager" />

    {
      contents.length > 1 && (
        <nav class="contents" aria-labelledby="contents-h">
          <p id="contents-h">On this page</p>
          <ol>
            {contents.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      tool && (
        <aside class="next" aria-labelledby="next-h">
          <h2 id="next-h">Ready to try {tool.name}?</h2>
          <p>{tool.pitch}</p>
          <p class="actions">
            <a class="button primary" href={`/tools/${tool.slug}/`}>
              Open {tool.name} <Icon name="arrow-right" />
            </a>
            {tool.docs && (
              <a class="button" href={tool.docs}>
                Read the docs <Icon name="external" />
              </a>
            )}
          </p>
        </aside>
      )
    }
  </article>
</Base>

<style>
  .post {
    max-width: 46rem;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
  }
  .back {
    margin-bottom: 1.5rem;
    font-size: var(--step--1);
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.02;
  }
  .meta {
    margin-bottom: 0.75rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .post :global(.lead) {
    width: 100%;
    margin-block: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .contents {
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--deep);
  }
  .contents p {
    margin-bottom: 0.375rem;
    font-weight: 600;
    color: var(--chrome);
  }
  .contents ol {
    margin: 0;
    padding-left: 1.25rem;
  }
  .contents li {
    padding-block: 0.125rem;
  }

  /* The post itself comes from Markdown, so none of it carries this page's scope */
  .prose :global(h2) {
    margin-top: 2.5em;
    font-size: var(--step-2);
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    margin-top: 1.75em;
    font-family: var(--body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
    scroll-margin-top: 5rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    max-width: var(--measure);
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.375rem;
  }
  .prose :global(strong) {
    color: var(--chrome);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--raised);
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    margin: 0 0 1.25em;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--deep);
    color: var(--chrome);
    line-height: 1.6;
  }
  /* A copy button on each block, added by scripts/copy.ts */
  .prose :global(.command) {
    position: relative;
    margin: 0 0 1.25em;
  }
  .prose :global(.command pre) {
    margin: 0;
    padding-right: 5.5rem;
  }
  .prose :global(.command button) {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--raised);
    color: var(--chrome);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .prose :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .prose :global(p:has(> img)) {
    max-width: none;
    margin-block: 1.5rem 0.5rem;
  }
  /* Two pictures in one paragraph sit side by side where there is room */
  .prose :global(p:has(> img + img)) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* The terminal and window screenshots differ a little in shape */
  .prose :global(p:has(> img + img) img) {
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top left;
  }
  @media (max-width: 36rem) {
    .prose :global(p:has(> img + img)) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* A line of emphasis alone under a picture is its caption */
  .prose :global(p:has(> img) + p > em:only-child) {
    display: block;
    font-size: var(--step--1);
    font-style: normal;
    color: var(--muted);
  }

  .next {
    margin-top: 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--accent, var(--mint));
    border-radius: var(--radius);
    background: var(--deep);
  }
  .next h2 {
    margin-bottom: 0.5rem;
    font-size: var(--step-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }
</style>
