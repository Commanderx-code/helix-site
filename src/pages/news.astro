---
// The latest releases of every public tool, newest first, with their notes
// as written on GitHub
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { tools, releaseNotes } from '../data/tools';
import { renderNotes } from '../data/notes';

const entries = (
  await Promise.all(tools.map(async (tool) => (await releaseNotes(tool.repo)).map((release) => ({ tool, release }))))
)
  .flat()
  .sort((a, b) => b.release.date.localeCompare(a.release.date));
const anyPublic = tools.some((t) => t.repo);

const when = (date: string) =>
  new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="What’s new: Helix Tech releases"
  description="The latest releases of Helix Toolbox, Helix Boot, webOS Launcher and Touchdown, with their notes."
  image="/og/news.png"
>
  <section class="wrap head">
    <p class="eyebrow" data-reveal>Releases</p>
    <h1 data-reveal>What’s new.</h1>
    <p class="lede" data-reveal>
      Every release of every public tool, as it ships. Follow along with the{' '}
      <a href="/feed.xml">RSS feed <Icon name="rss" size={14} /></a>
      {' '}or watch the repositories on GitHub.
    </p>
  </section>

  <section class="band">
    <div class="wrap">
      {
        entries.length > 0 ? (
          <ol class="timeline">
            {entries.map(({ tool, release }) => (
              <li class="release" data-tool={tool.slug} data-reveal>
                <p class="meta">
                  <time datetime={release.date}>{when(release.date)}</time>
                  <a class="tool" href={`/tools/${tool.slug}/`}>
                    {tool.name}
                  </a>
                  {release.prerelease && <span class="pre">Pre-release</span>}
                </p>
                <h2>
                  <a href={release.url}>{release.name}</a>
                </h2>
                {release.body.trim() ? (
                  <div class="notes" set:html={renderNotes(release.body)} />
                ) : (
                  <p class="notes">No notes were written for this release.</p>
                )}
                <p class="links">
                  <a href={release.url}>
                    {release.tag} on GitHub <Icon name="external" size={14} />
                  </a>
                </p>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty">
            {anyPublic
              ? 'The release list could not be read from GitHub just now. The repositories have it all.'
              : 'No public releases yet.'}
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }
  .head h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }
  .lede {
    max-width: 52ch;
    font-size: var(--step-1);
  }
  .lede a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--mint);
  }
  .band {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
  }

  /* A line down the left, a dot per release */
  .timeline {
    position: relative;
    max-width: 48rem;
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.4375rem;
    width: 2px;
    background: var(--line-strong);
  }
  .release {
    position: relative;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .release::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: -2rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--accent, var(--mint));
    box-shadow: 0 0 0 4px var(--ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .tool {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, var(--mint));
    text-decoration: none;
  }
  .tool:hover {
    color: var(--chrome);
  }
  .pre {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.75rem;
  }
  h2 {
    font-size: var(--step-2);
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--accent, var(--mint));
  }
  .notes {
    font-size: var(--step-0);
  }
  .notes :global(h1),
  .notes :global(h2),
  .notes :global(h3),
  .notes :global(h4) {
    margin: 1.25em 0 0.4em;
    font-family: var(--body);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
  }
  .notes :global(p),
  .notes :global(ul),
  .notes :global(ol) {
    max-width: var(--measure);
  }
  .notes :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--raised);
  }
  .notes :global(pre) {
    overflow-x: auto;
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--deep);
  }
  .notes :global(pre code) {
    padding: 0;
    background: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .empty {
    color: var(--muted);
  }
</style>
